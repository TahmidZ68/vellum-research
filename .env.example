# Application Environment
APP_ENV=development
APP_NAME=Vellum Research
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
LOG_LEVEL=INFO

# Database & Cache
DATABASE_URL=postgresql+asyncpg://ora:ora_password@localhost:5432/open_research_agent
REDIS_URL=redis://localhost:6379/0
# Set TASK_QUEUE_MODE=arq when running Redis + ARQ worker (default in Docker Compose),
# or TASK_QUEUE_MODE=inline for single-process local development without Redis.
TASK_QUEUE_MODE=arq

# Authentication (JWT)
JWT_SECRET_KEY=change-me-to-a-different-long-random-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# LLM Provider Configuration
# Supported values: gemini | openai_compatible | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Search Provider Configuration
# Supported values: tavily | mock
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Demo / Mock Mode (explicitly labels outputs as sample/mock data when enabled)
ALLOW_MOCK_PROVIDERS=false

# URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Research Engine Limits & Security
MAX_SEARCH_ITERATIONS=2
MAX_EXTRACTION_CONCURRENCY=4
EXTRACTION_TIMEOUT_SECONDS=12
MAX_EXTRACTION_BYTES=1500000
MAX_REDIRECTS=3
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RESEARCH_RUNS_PER_USER_PER_DAY=30
